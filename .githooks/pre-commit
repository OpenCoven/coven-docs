#!/usr/bin/env bash
# Coven pre-commit: secret scanning via gitleaks
# Shared across all OpenCoven repos. Edit .gitleaks.toml in repo root to allow-list false positives.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

GITLEAKS=$(command -v gitleaks 2>/dev/null || true)

if [ -z "$GITLEAKS" ]; then
  echo -e "${YELLOW}[coven-hook] gitleaks not found — skipping secret scan. Install: brew install gitleaks${NC}"
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG_ARG=""

if [ -f "$REPO_ROOT/.gitleaks.toml" ]; then
  CONFIG_ARG="$REPO_ROOT/.gitleaks.toml"
elif [ -f "$SCRIPT_DIR/../../.gitleaks.toml" ]; then
  # Resolve from .githooks/ up to repo parent (OpenCoven/.gitleaks.toml)
  CONFIG_ARG="$(cd "$SCRIPT_DIR/../.." && pwd)/.gitleaks.toml"
fi

echo -e "${YELLOW}[coven-hook] Scanning staged files for secrets…${NC}"

if [ -n "$CONFIG_ARG" ]; then
  RESULT=$("$GITLEAKS" protect --staged -c "$CONFIG_ARG" --source "$REPO_ROOT" --exit-code 1 2>&1) && STATUS=0 || STATUS=$?
else
  RESULT=$("$GITLEAKS" protect --staged --source "$REPO_ROOT" --exit-code 1 2>&1) && STATUS=0 || STATUS=$?
fi

echo "$RESULT"

if [ "$STATUS" -eq 0 ]; then
  echo -e "${GREEN}[coven-hook] ✓ No secrets detected.${NC}"
  exit 0
else
  echo ""
  echo -e "${RED}[coven-hook] ✗ Secret(s) detected in staged files. Commit blocked.${NC}"
  echo ""
  echo "  Review:  gitleaks protect --staged --verbose"
  echo "  Allow a false positive — add inline comment:  # gitleaks:allow"
  echo "  Or add a rule to .gitleaks.toml in the repo root."
  echo ""
  echo "  Emergency bypass (avoid):  git commit --no-verify"
  echo ""
  exit 1
fi
