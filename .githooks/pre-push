#!/usr/bin/env bash
# Coven docs pre-push: run the smallest release-integrity checks implied by
# the files being pushed. Repository CI remains authoritative and runs the full
# `pnpm verify` contract.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"

changed=""
while read -r _local_ref local_oid _remote_ref remote_oid; do
  [ "$local_oid" = "$ZERO" ] && continue
  if [ "$remote_oid" = "$ZERO" ]; then
    base="$(git merge-base "$local_oid" origin/main 2>/dev/null || true)"
    if [ -n "$base" ]; then
      files="$(git diff --name-only "$base" "$local_oid" 2>/dev/null || true)"
    else
      files="$(git show --name-only --pretty=format: "$local_oid" 2>/dev/null || true)"
    fi
  else
    files="$(git diff --name-only "$remote_oid" "$local_oid" 2>/dev/null || true)"
  fi
  changed="$changed
$files"
done

if [ -z "$(printf '%s' "$changed" | tr -d '[:space:]')" ]; then
  changed="unknown"
fi

PNPM="$(command -v pnpm 2>/dev/null || true)"
if [ -z "$PNPM" ]; then
  echo -e "${YELLOW}[coven-hook] pnpm not found — skipping docs checks. Repository CI will still enforce them.${NC}"
  exit 0
fi

run_check() {
  local label="$1"
  shift
  echo -e "${YELLOW}[coven-hook] ${label}…${NC}"
  if (cd "$REPO_ROOT" && "$@"); then
    echo -e "${GREEN}[coven-hook] ✓ ${label}.${NC}"
  else
    echo ""
    echo -e "${RED}[coven-hook] ✗ ${label} failed. Push blocked.${NC}"
    echo "  Emergency bypass (avoid): git push --no-verify"
    exit 1
  fi
}

if printf '%s\n' "$changed" | grep -qE '^content/docs/|^docs/site-manifest\.json$|^scripts/check-|^scripts/validate-links\.mjs$|^components/(mdx-components|hub-cards|search-dialog|docs-status)|^lib/docs-manifest\.ts$'; then
  run_check "Validating content, routes, and anchors" "$PNPM" run check:content
  run_check "Validating internal links" "$PNPM" run check:links
  run_check "Validating heading fragments" "$PNPM" run check:anchors
fi

if printf '%s\n' "$changed" | grep -qE '^openapi/|^scripts/(build-openapi-samples|generate-openapi-docs|check-generated)\.mjs$|^content/docs/openapi/'; then
  run_check "Validating generated OpenAPI docs" "$PNPM" run check:generated
fi

if printf '%s\n' "$changed" | grep -qE '\.(ts|tsx|mjs)$|^package\.json$|^tsconfig\.json$'; then
  # Ensure the ignored built OpenAPI input exists before TypeScript resolves it.
  run_check "Preparing OpenAPI samples" "$PNPM" run openapi:samples
  run_check "Type-checking" "$PNPM" run typecheck
fi
