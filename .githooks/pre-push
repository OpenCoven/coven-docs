#!/usr/bin/env bash
# Coven pre-push: validate Mermaid diagrams before docs land on the remote.
# Runs `pnpm run check:mermaid` (transform + svg-normalize + parse) when the
# push touches .mdx or Mermaid tooling. A backtick in a node label once passed
# the build and only broke at client render — this catches that class locally.
#
# Tracked + shared: activated via `core.hooksPath=.githooks` (set by the
# package.json "prepare" script on install).

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"

# Collect files changed across the commits being pushed. stdin lines are:
#   <local ref> <local oid> <remote ref> <remote oid>
changed=""
while read -r _local_ref local_oid _remote_ref remote_oid; do
  [ "$local_oid" = "$ZERO" ] && continue  # branch deletion, nothing to check
  if [ "$remote_oid" = "$ZERO" ]; then
    # New remote branch: diff from its merge-base with origin/main when we can.
    base="$(git merge-base "$local_oid" origin/main 2>/dev/null || true)"
    if [ -n "$base" ]; then
      files="$(git diff --name-only "$base" "$local_oid" 2>/dev/null || true)"
    else
      files="$(git show --name-only --pretty=format: "$local_oid" 2>/dev/null || true)"
    fi
  else
    files="$(git diff --name-only "$remote_oid" "$local_oid" 2>/dev/null || true)"
  fi
  changed="$changed
$files"
done

# Decide relevance. If we can't tell what changed, run the check (safe default).
relevant=1
if [ -n "$(printf '%s' "$changed" | tr -d '[:space:]')" ]; then
  if printf '%s\n' "$changed" | grep -qE '\.mdx$|scripts/.*mermaid|components/mermaid|lib/(remark-mermaid|mermaid-svg)'; then
    relevant=1
  else
    relevant=0
  fi
fi

if [ "$relevant" -ne 1 ]; then
  exit 0
fi

PNPM=$(command -v pnpm 2>/dev/null || true)
if [ -z "$PNPM" ]; then
  echo -e "${YELLOW}[coven-hook] pnpm not found — skipping Mermaid check. Install pnpm to enable it.${NC}"
  exit 0
fi

echo -e "${YELLOW}[coven-hook] Validating Mermaid diagrams (check:mermaid)…${NC}"

if (cd "$REPO_ROOT" && "$PNPM" run check:mermaid); then
  echo -e "${GREEN}[coven-hook] ✓ Mermaid diagrams valid.${NC}"
  exit 0
else
  echo ""
  echo -e "${RED}[coven-hook] ✗ Invalid Mermaid diagram(s). Push blocked.${NC}"
  echo ""
  echo "  Re-run:  pnpm run check:mermaid"
  echo "  Fix the reported file:line — keep node labels free of backticks; use \\n for line breaks."
  echo ""
  echo "  Emergency bypass (avoid):  git push --no-verify"
  echo ""
  exit 1
fi
