{
  "name": "coven-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:english-only && next build",
    "check:fumadocs": "node scripts/check-fumadocs-platform.mjs",
    "check:english-only": "node scripts/check-english-only.mjs",
    "check:links": "node scripts/validate-links.mjs",
    "check:mermaid": "node scripts/check-mermaid-transform.mjs && node scripts/check-mermaid-svg-normalize.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:obsidian": "node scripts/generate-obsidian.mjs",
    "start": "next start",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@iconify/react": "^5.2.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "d3-force": "^3.0.0",
    "fumadocs-core": "^16.8.11",
    "fumadocs-epub": "^1.1.0",
    "fumadocs-mdx": "^15.0.6",
    "fumadocs-obsidian": "^0.1.0",
    "fumadocs-ui": "^16.8.11",
    "lucide-react": "^0.488.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "next-validate-link": "^1.6.6",
    "puppeteer": "^25.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-force-graph-2d": "^1.29.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
